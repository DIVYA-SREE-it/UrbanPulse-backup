# UrbanPulse-DADIS-compatible — repo root .gitignore

# --- Python ---
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/

# --- Node ---
node_modules/
fleetbus/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Build output ---
dist/
build/
fleetbus/dist/
fleetbus/build/

# --- Runtime data (regenerated, not source) ---
*.db
*.sqlite
*.sqlite3
fleetbus/backend/data/
fleetbus/backend/results/
fleetbus/backend/videos/uploads/
fleetbus/backend/uploads/
.sites-runtime/

# --- Model weights ---
# Pretrained COCO checkpoint — re-downloadable, do not commit
fleetbus/backend/models/yolov8n.pt
*.onnx
*.weights

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Misc ---
*.bak
*.tmp